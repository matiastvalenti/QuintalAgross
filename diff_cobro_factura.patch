+const INVOICE_RECEIPT_POPUP_WIDTH = 1280;
+const INVOICE_RECEIPT_POPUP_HEIGHT = 820;
+
+/**
+ * Abre un recibo/cobro prellenado desde una factura.
+ * @param {Object} invoice - Objeto factura con { id, number, entity_id, currency, pending_amount, total_amount, amount_applied }
+ * @param {Object} options - Opciones de ventana
+ */
+export function openNuevoReciboDesdeFactura(invoice, options = {}) {
+  if (!invoice?.id) return;
+  const path = `/standalone/cobros/factura/${invoice.id}`;
+  const popup = openStandaloneWindow(path, `receipt-invoice-${invoice.id}`, { width: INVOICE_RECEIPT_POPUP_WIDTH, height: INVOICE_RECEIPT_POPUP_HEIGHT, ...options });
+  
+  if (popup) {
+    try {
+      popup.resizeTo(INVOICE_RECEIPT_POPUP_WIDTH, INVOICE_RECEIPT_POPUP_HEIGHT);
+    } catch (e) {
+      console.warn("No se pudo redimensionar popup de recibo", e);
+    }
+  }
+  
+  return popup;
+}
